# ===== Aiswarya Library Client Environment =====

# Backend API base URL (Render in production)
# -------------------------------------------
# Leave empty for local development — the app calls relative /api and Vite
# proxies it to http://localhost:5000 (see vite.config.js).
# In production set this on Vercel (or in client/.env):
#   VITE_API_BASE_URL=https://your-api.onrender.com/api
# VITE_API_BASE_URL=

# Firebase Phone Authentication (optional)
# -----------------------------------------
# Membership Registration uses Firebase phone verification (SMS OTP) when these
# values are set. If VITE_FIREBASE_API_KEY is empty, the app falls back to the
# server's own WhatsApp OTP flow, so development works without credentials.
#
# To enable SMS OTP:
#   1. Create a Firebase project at https://console.firebase.google.com
#   2. Enable the Phone provider (Authentication > Sign-in method > Phone)
#   3. Copy the web app config values below (Project settings > Your apps)
#   4. In a real (non-test) Firebase project, add this app's domain to the
#      authorised domains list under Authentication > Settings.
#
# The phone number must be ONLY 10 digits in the registration form; the app
# prepends +91 (India) before calling signInWithPhoneNumber.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Image uploads
# -------------
# All image uploads (member photo, event gallery, community service photos,
# program minutes/photos) go through the backend POST /api/upload endpoint.
# No client storage configuration is required.