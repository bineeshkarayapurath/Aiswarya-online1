# ===== Aiswarya Library Server Environment =====
PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Comma-separated frontend origins allowed by CORS (local dev + production).
# localhost, 127.0.0.1, https://aiswarya-online1.vercel.app and *.vercel.app /
# *.onrender.com are always allowed by the code — this env var only ADDS more.
CLIENT_URLS=

# Public base URL of THIS backend (used to return absolute image/PDF URLs).
# Set to your Render URL in production, e.g. https://aiswarya-api.onrender.com
PUBLIC_API_URL=http://localhost:5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/aiswarya_library

# JWT secret for authentication tokens
JWT_SECRET=change-me-to-a-long-random-string

# Master Security PIN for the Authority Zone (OTP + this PIN).
# REQUIRED in production — there is no default and the server refuses to boot
# without it. Generate your own; do not reuse the placeholder below.
MASTER_PIN=

# Super Admin phone numbers (comma separated) - President, Secretary, Executive Member
# Format: international format without '+' e.g. 919876543210
# Authority login is authorised ONLY for these numbers.
SUPER_ADMIN_PHONES=919876543210

# Local dev convenience: echo the generated OTP back in the API response so the
# UI can display it. Ignored in production. Leave empty and read the code from
# the server console instead.
DEV_ECHO_OTP=

# ---- Meta WhatsApp Cloud API (OTP delivery) ----
# OTPs are sent as a WhatsApp message, not an SMS. Both values are required in
# production — the server refuses to boot without them. In local dev nothing is
# sent: the OTP is written to the server console instead.
# Setup: business.facebook.com -> WhatsApp Manager. Phone Number ID is the
# numeric id of the sending number; the token is a permanent System User token
# with the whatsapp_business_messaging scope (a temporary 24h token expires and
# the app stops sending).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# ---- Authentication template ----
# Create the template in WhatsApp Manager -> Message Templates with category
# AUTHENTICATION. Meta fixes the body ("<code> is your verification code."),
# so the template can NOT contain custom wording. Once approved, its exact name
# goes here.
WHATSAPP_TEMPLATE_NAME=login_otp_template
# Must match the language the template was approved in, or Meta rejects it.
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Set to false if the approved template has NO one-tap autofill / copy-code
# button. Leave true if it does — the OTP is then also sent as a button
# parameter, which Meta requires for that button to work.
WHATSAPP_TEMPLATE_HAS_OTP_BUTTON=true
# Graph version used for the /messages call. Each version is pinned for ~2
# years, so bump this before it expires.
WHATSAPP_GRAPH_VERSION=v17.0
# Request timeout in milliseconds.
WHATSAPP_TIMEOUT_MS=10000

# OTP length: 4 or 6 (frontend expects 6)
OTP_DIGITS=6

# Membership ID prefix used when generating IDs e.g. ALC-2026-0001
MEMBERSHIP_PREFIX=ALC
MEMBERSHIP_YEAR=2026

# Where generated PDFs and uploaded photos are stored (relative to server/)
STORAGE_DIR=storage

# ImgBB API key (optional, free hosting for uploaded images)
# ----------------------------------------------------------
# Get a free key at https://api.imgbb.com/. When set, all images uploaded via
# POST /api/upload are relayed to ImgBB and served from its permanent HTTPS CDN
# instead of being kept on server disk. Leave empty to store images under
# storage/photos/ and serve them via /uploads/.
IMG_BB_API_KEY=

# OTP lifetime in minutes
OTP_EXPIRY_MINUTES=5