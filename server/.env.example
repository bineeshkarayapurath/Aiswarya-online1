# ===== Aiswarya Library Server Environment =====
PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Comma-separated frontend origins allowed by CORS.
# These are ALWAYS allowed and need not be listed here: http://localhost:5173,
# http://127.0.0.1:5173, https://aiswarya-online1.vercel.app and the club's
# custom domain (https://www.aiswaryakuppakolly.online, plus its non-www form) —
# this env var only ADDS more.
#
# Matching is EXACT (scheme + host + port), not a wildcard: the older comment
# here claimed *.vercel.app / *.onrender.com were always allowed, which was
# never true. Anything else - a staging frontend, a second custom domain - must
# be listed here. An origin that is not listed gets responses with no
# Access-Control-Allow-Origin header, and the browser discards them, which looks
# like the whole app failing to load rather than a CORS problem.
#
# Note the production frontend is reached through the custom domain above, not
# through the *.vercel.app host, so that is the origin the browser sends and the
# one that has to be allowed.
#
# A request whose Origin matches this server's own Host is treated as same-origin
# and allowed without being listed, so a deployment serving the built client AND
# the API from one host works with this left empty.
CLIENT_URLS=

# Where the built client bundle lives (directory containing index.html).
# Defaults to client/dist relative to the repo root. Only needs setting if your
# host's build step writes the bundle somewhere else.
CLIENT_DIST_DIR=

# Public base URL of THIS backend (used to return absolute image/PDF URLs).
# Set to your Render URL in production, e.g. https://aiswarya-api.onrender.com
PUBLIC_API_URL=http://localhost:5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/aiswarya_library

# JWT secret for authentication tokens
JWT_SECRET=change-me-to-a-long-random-string

# AES-256-CBC key for field-level encryption of sensitive member data at rest
# (address, email, occupation, education). Use a long random string.
# KEEP IT STABLE: changing this value after members exist makes their already
# encrypted fields undecryptable. When unset, field encryption falls back to
# JWT_SECRET (fine for local dev, but set a dedicated key in production).
FIELD_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Membership IDs that hold top-level ADMIN authority regardless of designation.
# Comma separated. Together with President / Secretary this is the ONLY way an
# account becomes an admin; every other Executive Committee member, Vice
# President and general member is a non-admin.
ADMIN_MEMBER_IDS=ALC-001,ALC-002,ALC-003

# Super Admin phone numbers (comma separated) - President, Secretary, Executive Member
# Format: 10-digit national number e.g. 9876543210
# Authority Zone login is authorised ONLY for these numbers. The officer signs in
# with this number plus THEIR OWN account password — this list only decides which
# numbers may open the Authority Zone at all.
SUPER_ADMIN_PHONES=9876543210

# ---- Passwords ----
# Member and officer accounts are protected by a bcrypt-hashed password. There is
# no OTP, no SMS delivery and no external auth provider.
#
# bcrypt work factor. Higher = slower to hash and slower to brute-force offline.
# 12 costs roughly 250 ms per hash on commodity hardware. The cost is only paid
# at registration and login, so raising it is nearly free for users.
BCRYPT_SALT_ROUNDS=12
# Minimum password length, enforced server-side in authController and mirrored by
# the registration form.
PASSWORD_MIN_LENGTH=8
# Maximum length in characters. bcrypt silently truncates past 72 BYTES, so two
# passwords sharing a 72-byte prefix would otherwise be interchangeable. The
# server refuses anything longer rather than pretending to hash it.
PASSWORD_MAX_LENGTH=72

# Membership ID prefix used when generating IDs e.g. ALC-001
MEMBERSHIP_PREFIX=ALC

# Where generated PDFs and uploaded photos are stored (relative to server/)
STORAGE_DIR=storage

# ImgBB API key (optional, free hosting for uploaded images)
# ----------------------------------------------------------
# Get a free key at https://api.imgbb.com/. When set, all images uploaded via
# POST /api/upload are relayed to ImgBB and served from its permanent HTTPS CDN
# instead of being kept on server disk. Leave empty to store images under
# storage/photos/ and serve them via /uploads/.
IMG_BB_API_KEY=

# AI Book Assistant (optional)
# ----------------------------------------------------------
# Any OpenAI-compatible provider works. With AI_API_KEY empty the feature reports
# itself as unconfigured in the member dashboard and makes no upstream calls.
#
#   OpenAI      AI_BASE_URL=https://api.openai.com/v1            AI_MODEL=gpt-4o-mini
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1        AI_MODEL=<any listed model>
#   Groq        AI_BASE_URL=https://api.groq.com/openai/v1      AI_MODEL=llama-3.3-70b-versatile
#   Gemini      AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama      AI_BASE_URL=http://127.0.0.1:11434/v1            AI_API_KEY can be "ollama"
#
# The key ALONE is only enough for OpenAI. Any other provider also needs its
# AI_BASE_URL above and an AI_MODEL that provider recognises - Gemini model ids
# change often, so take the current one from the model list in AI Studio. A wrong
# base URL or model id surfaces as "The AI service could not find that endpoint
# or model" instead of a generic failure.
#
# Set the value with NO surrounding quotes. Surrounding quotes are stripped on
# read, but a dashboard that stores them literally will otherwise hand the
# provider a key with quote characters attached, which comes back as a 401.
# A Gemini key from AI Studio always begins with "AIza".
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Upstream request timeout, and the per-member hourly question cap. Each
# question costs money at the provider, so keep AI_MAX_PER_HOUR modest.
AI_TIMEOUT_MS=25000
AI_MAX_PER_HOUR=20
